
# ============================================================
# LLM 配置
# ============================================================

# LLM 提供商: deepseek 或 openai
LLM_PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_API_KEY=sk-6367ddc28f584f1ab478bab260fc075c
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 配置（备用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM 请求配置
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_REQUEST_INTERVAL=1.0

# ============================================================
# 搜索配置
# ============================================================

# 搜索引擎: serper, duckduckgo, bing
SEARCH_ENGINE=serper

# Serper API (推荐，高质量搜索结果)
SERPER_API_KEY=your_serper_api_key_here

# DuckDuckGo 配置（免费，无需API Key）
DUCKDUCKGO_MAXRESULTS=10

# Bing 搜索配置
BING_API_KEY=your_bing_api_key_here

# 搜索通用配置
DEFAULT_SEARCH_RESULTS=10
SEARCH_TIMEOUT=30
SEARCH_ITERATIONS=2

# ============================================================
# Agent 配置
# ============================================================

# 主管Agent
SUPERVISOR_MAX_ITERATIONS=10
SUPERVISOR_TIMEOUT=300

# 采集Agent
COLLECTOR_MAX_RETRIES=3
COLLECTOR_TIMEOUT=180

# 分析Agent
ANALYZER_MAX_RETRIES=3
ANALYZER_TIMEOUT=180

# 撰写Agent
WRITER_MAX_RETRIES=3
WRITER_TIMEOUT=180

# 消息Token限制
MESSAGE_TOKEN_LIMIT=16000

# ============================================================
# 输出配置
# ============================================================

OUTPUT_DIR=./output
OUTPUT_FORMAT=markdown
SAVE_INTERMEDIATE=true
GENERATE_CHARTS=false

# ============================================================
# 日志配置
# ============================================================

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_FORMAT=competiscope_{date}.log
LOG_TO_CONSOLE=true

# ============================================================
# 知识库配置（可选）
# ============================================================

ENABLE_KNOWLEDGE_BASE=false
KNOWLEDGE_BASE_DIR=./knowledge_base
EMBEDDING_DIM=1536
SIMILARITY_THRESHOLD=0.7

# ============================================================
# 其他配置
# ============================================================

# 并发任务数
MAX_CONCURRENT_TASKS=3

# 请求间隔（秒）
MIN_REQUEST_INTERVAL=0.5

# 是否启用代理
ENABLE_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# SSL验证（某些企业环境可能需要关闭）
VERIFY_SSL=true
